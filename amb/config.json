{
  "hosts": {
    "local": {
      "ssh": null,
      "work_root": "~/amb-work",
      "provider": "VPS 官方 Claude API（有独立额度）"
    },
    "<REDACTED_HOST_A>": {
      "ssh": "<REDACTED_HOST_A>",
      "work_root": "~/amb-work",
      "forbidden": [
        "lark-cli",
        "<REDACTED_IP>:17890 代理配置"
      ],
      "provider": "开发机第三方 Claude API（<REDACTED_PATH>，非 VPS 官方额度）",
      "claude_launcher": "bash <REDACTED_PATH>",
      "models": {
        "claude-fable-5-2": "claude-fable-5-1"
      }
    },
    "<REDACTED_HOST_C>": {
      "ssh": "<REDACTED_HOST_C>",
      "work_root": "~/amb-work",
      "models": {"claude-fable-5-2": "claude-fable-5-1"},
      "note": "Mac：网页和桌面图形界面的活。非交互 SSH 的 PATH 不含 ~/.local/bin，各角色用 host_commands 补 PATH。"
    },
    "<REDACTED_HOST_D>": {
      "ssh": null,
      "work_root": "~/amb-work"
    }
  },
  "roles": {
    "exec.sol": {
      "model": "gpt-6.2-sol",
      "cmd": "codex exec -m gpt-6.2-sol -c model_reasoning_effort=medium -C {workdir} --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -o {out_file} -",
      "host_commands": {
        "<REDACTED_HOST_C>": "env PATH=<REDACTED_PATH>:/usr/bin:/bin:/usr/sbin:/sbin codex exec -m gpt-6.2-sol -c model_reasoning_effort=medium -C {workdir} --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -o {out_file} -"
      }
    },
    "exec.opus": {
      "model": "claude-opus-5-5",
      "cmd": "claude -p --model claude-opus-5-5 --effort medium --no-session-persistence --permission-mode acceptEdits",
      "host_commands": {
        "<REDACTED_HOST_A>": "bash <REDACTED_PATH> -p --model claude-opus-5-5 --effort medium --no-session-persistence",
        "local": "claude -p --model claude-opus-5-5 --effort medium --no-session-persistence --permission-mode bypassPermissions",
        "<REDACTED_HOST_C>": "env PATH=<REDACTED_PATH>:/usr/bin:/bin:/usr/sbin:/sbin claude -p --model claude-opus-5-5 --effort medium --no-session-persistence --permission-mode bypassPermissions"
      }
    },
    "exec.opus-high": {
      "model": "claude-opus-5-5",
      "cmd": "claude -p --model claude-opus-5-5 --effort high --no-session-persistence --permission-mode acceptEdits",
      "host_commands": {
        "<REDACTED_HOST_A>": "bash <REDACTED_PATH> -p --model claude-opus-5-5 --effort high --no-session-persistence",
        "local": "claude -p --model claude-opus-5-5 --effort high --no-session-persistence --permission-mode bypassPermissions",
        "<REDACTED_HOST_C>": "env PATH=<REDACTED_PATH>:/usr/bin:/bin:/usr/sbin:/sbin claude -p --model claude-opus-5-5 --effort high --no-session-persistence --permission-mode bypassPermissions"
      }
    },
    "review.opus": {
      "model": "claude-opus-5-5",
      "cmd": "claude -p --model claude-opus-5-5 --effort high --no-session-persistence --permission-mode plan",
      "host_commands": {
        "<REDACTED_HOST_A>": "bash <REDACTED_PATH> -p --model claude-opus-5-5 --effort high --no-session-persistence --permission-mode plan",
        "<REDACTED_HOST_C>": "env PATH=<REDACTED_PATH>:/usr/bin:/bin:/usr/sbin:/sbin claude -p --model claude-opus-5-5 --effort high --no-session-persistence --permission-mode plan"
      }
    },
    "review.codex": {
      "model": "gpt-6.2-sol",
      "cmd": "codex exec -m gpt-6.2-sol -c model_reasoning_effort=medium -C {workdir} --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -o {out_file} -",
      "host_commands": {
        "<REDACTED_HOST_C>": "env PATH=<REDACTED_PATH>:/usr/bin:/bin:/usr/sbin:/sbin codex exec -m gpt-6.2-sol -c model_reasoning_effort=medium -C {workdir} --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -o {out_file} -"
      }
    },
    "review.astra": {
      "model": "gpt-6.2-astra",
      "cmd": "codex exec -m gpt-6.2-astra -c model_reasoning_effort=medium -C {workdir} --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -o {out_file} -"
    },
    "plan.opus": {
      "model": "claude-opus-5-5",
      "host": "local",
      "cmd": "claude -p --model claude-opus-5-5 --effort high --no-session-persistence --permission-mode plan"
    },
    "plan.fable": {
      "model": "claude-fable-5-2",
      "host": "local",
      "cmd": "claude -p --model claude-fable-5-2 --effort low --no-session-persistence --permission-mode plan"
    },
    "ask": {
      "model": "claude-opus-5-5",
      "cmd": "claude -p --model claude-opus-5-5 --effort medium --no-session-persistence --permission-mode plan",
      "host_commands": {
        "<REDACTED_HOST_A>": "bash <REDACTED_PATH> -p --model claude-opus-5-5 --effort medium --no-session-persistence --permission-mode plan",
        "<REDACTED_HOST_C>": "env PATH=<REDACTED_PATH>:/usr/bin:/bin:/usr/sbin:/sbin claude -p --model claude-opus-5-5 --effort medium --no-session-persistence --permission-mode plan"
      }
    },
    "exec.fable": {
      "model": "claude-fable-5-2",
      "cmd": "claude -p --model claude-fable-5-2 --effort low --no-session-persistence --permission-mode acceptEdits",
      "host_commands": {
        "<REDACTED_HOST_A>": "bash <REDACTED_PATH> -p --model claude-fable-5-1 --effort low --no-session-persistence",
        "local": "claude -p --model claude-fable-5-2 --effort low --no-session-persistence --permission-mode bypassPermissions",
        "<REDACTED_HOST_D>": "<REDACTED_PATH>"
      }
    },
    "exec.astra": {
      "model": "gpt-6.2-astra",
      "cmd": "codex exec -m gpt-6.2-astra -c model_reasoning_effort=medium -C {workdir} --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -o {out_file} -"
    },
    "plan.fable.dev": {
      "model": "claude-fable-5-1",
      "host": "<REDACTED_HOST_A>",
      "cmd": "bash <REDACTED_PATH> -p --model claude-fable-5-1 --effort high --no-session-persistence --permission-mode plan"
    },
    "exec.fable.dev": {
      "model": "claude-fable-5-1",
      "host": "<REDACTED_HOST_A>",
      "cmd": "bash <REDACTED_PATH> -p --model claude-fable-5-1 --effort high --no-session-persistence"
    }
  },
  "ladder": {
    "sol": [
      "sol",
      "opus",
      "replan"
    ],
    "opus": [
      "opus",
      "opus-high",
      "replan"
    ],
    "fable": [
      "fable",
      "opus-high",
      "replan"
    ],
    "astra": [
      "astra",
      "sol",
      "replan"
    ]
  },
  "reviewer": {
    "sol": "review.opus",
    "opus": "review.codex",
    "opus-high": "review.codex",
    "fable": "review.codex",
    "astra": "review.opus"
  },
  "runner_wake": true,
  "speed_supervisor": true,
  "sentinel": true,
  "planner": "plan.opus",
  "repos": {
    "<REDACTED_HOST_A>:~/amb-sandbox": {
      "auto_merge": true,
      "push": false
    }
  },
  "defaults": {
    "max_attempts": 3,
    "ssh_timeout_s": 20,
    "accept_timeout_s": 600,
    "plan_minutes": 20,
    "model_idle_timeout_s": 0,
    "lead_minutes": 240
  },
  "webhook": {
    "config_file": "~/amb/.secrets/ambition-webhook.json",
    "metadata_only": true,
    "client_error_backoff_s": 55
  },
  "feishu": {
    "cmd": "<REDACTED_PATH> --text '{text}' --idempotency-key '{event_id}'",
    "enabled": false,
    "require_receipt": true,
    "alignment_enabled": false
  },
  "linear": {
    "api_key_file": "<REDACTED_PATH>",
    "dry_run": false,
    "auto_create": true,
    "app_cmd": "~/bin/linear-app",
    "endpoint": "https://api.linear.app/graphql"
  },
  "heartbeat": "~/amb/heartbeat",
  "context_hooks": [],
  "supervisor": {
    "enabled": true,
    "host": "<REDACTED_HOST_A>",
    "outbox": "<REDACTED_PATH>",
    "pending": "<REDACTED_PATH>",
    "since": "2026-11-20T04:46:18+00:00"
  },
  "notifications_since": "2026-11-20T04:46:18+00:00",
  "requester_reply": {
    "enabled": true,
    "bind_on_submit": true,
    "cmd": "<REDACTED_PATH> deliver {job_id}",
    "since": "2026-11-20T10:27:23+00:00"
  },
  "lead_mode": true,
  "review_events": true,
  "quota_fallback": {
    "plan": [
      "plan.fable.dev",
      "exec.astra"
    ],
    "exec": [
      "exec.fable.dev",
      "exec.astra"
    ],
    "repair": [
      "exec.fable.dev",
      "exec.astra"
    ]
  }
}
