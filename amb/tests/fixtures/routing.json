{
  "hosts": {
    "local": {
      "ssh": null,
      "work_root": "~/amb-work"
    },
    "<REDACTED_HOST_A>": {
      "ssh": "example-worker",
      "work_root": "~/amb-work",
      "models": {
        "claude-fable-5-2": "claude-fable-5-1"
      },
      "provider": "第三方"
    }
  },
  "roles": {
    "exec.fable": {
      "model": "claude-fable-5-2",
      "cmd": "claude -p --model claude-fable-5-2 --effort low",
      "host_commands": {
        "<REDACTED_HOST_A>": "bash <REDACTED_PATH> -p --model claude-fable-5-1 --effort low"
      }
    },
    "exec.opus": {
      "model": "claude-opus-5-5",
      "cmd": "claude -p --model claude-opus-5-5 --effort medium",
      "host_commands": {
        "<REDACTED_HOST_A>": "bash <REDACTED_PATH> -p --model claude-opus-5-5 --effort medium"
      }
    },
    "exec.opus-high": {
      "model": "claude-opus-5-5",
      "cmd": "claude -p --model claude-opus-5-5 --effort high",
      "host_commands": {
        "<REDACTED_HOST_A>": "bash <REDACTED_PATH> -p --model claude-opus-5-5 --effort high"
      }
    },
    "review.opus": {
      "model": "claude-opus-5-5",
      "cmd": "claude -p --model claude-opus-5-5 --effort high",
      "host_commands": {
        "<REDACTED_HOST_A>": "bash <REDACTED_PATH> -p --model claude-opus-5-5 --effort high"
      }
    },
    "ask": {
      "model": "claude-opus-5-5",
      "cmd": "claude -p --model claude-opus-5-5 --effort low",
      "host_commands": {
        "<REDACTED_HOST_A>": "bash <REDACTED_PATH> -p --model claude-opus-5-5 --effort low"
      }
    },
    "review.codex": {
      "model": "demo-review",
      "cmd": "codex exec -"
    },
    "exec.astra": {
      "model": "demo-astra",
      "cmd": "codex exec -"
    },
    "plan.fable.dev": {
      "host": "<REDACTED_HOST_A>",
      "model": "claude-fable-5-1",
      "cmd": "bash <REDACTED_PATH> -p --model claude-fable-5-1"
    },
    "exec.fable.dev": {
      "host": "<REDACTED_HOST_A>",
      "model": "claude-fable-5-1",
      "cmd": "bash <REDACTED_PATH> -p --model claude-fable-5-1"
    }
  },
  "quota_fallback": {
    "plan": [
      "plan.fable.dev",
      "exec.astra"
    ]
  }
}
