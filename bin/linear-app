def token(rejected=None):
    with open(TOKEN + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return cached_token(rejected)


def cached_token(rejected):
    try:
        with open(TOKEN) as f:
            t = json.load(f)
            expires_at = os.fstat(f.fileno()).st_mtime + int(t.get("expires_in", 0))
    except FileNotFoundError:
        t, expires_at = {}, 0
    if expires_at - time.time() < 300 or t.get("access_token") == rejected:
        c = json.load(open(CLIENT))
        basic = base64.b64encode(f"{c['client_id']}:{c['client_secret']}".encode()).decode()
        req = urllib.request.Request("https://api.linear.app/oauth/token",
                                     data=urllib.parse.urlencode({"grant_type": "client_credentials", "scope": "read,write,app:mentionable"}).encode(),
                                     headers={"<REDACTED_AUTH_HEADER>": "Basic " + basic, "Content-Type": "application/x-www-form-urlencoded"})
        t = json.loads(urllib.request.urlopen(req, timeout=30).read())
        tmp = TOKEN + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(t, f)
        os.replace(tmp, TOKEN)
    return t["access_token"]

JOB_ID = re.compile(r"(?<![\w/~.-])J-\d{4}-\w+(?:/\w+)*")

URL_PUNCTUATION = re.compile(r'(https?://[^\s<>()\[\]`"。，；：）】》]+)([。，；：）】》])')


def humanize(x, *, jobs=True):
    """卡面和评论是给人看的：编排器的单号（<REDACTED_ID> 这类）换成那一单的标题，查不到就说“之前那一单”。"""
    if isinstance(x, dict):
        return {k: humanize(v, jobs=jobs) for k, v in x.items()}
    if isinstance(x, list):
        return [humanize(v, jobs=jobs) for v in x]
    if not isinstance(x, str):
        return x
    def name(m):
        try:
            t = json.load(open(os.path.expanduser("~/amb/jobs/%s/job.json" % m.group(0).split("/")[0])))["title"]
            return ("「%s」等几单" if "/" in m.group(0) else "「%s」那一单") % pretty_title(t)
        except (OSError, ValueError, KeyError):
            return "之前那一单"
    x = JOB_ID.sub(name, x) if jobs else x
    return URL_PUNCTUATION.sub(r"\1 \2", x)

def gql(query, variables=None, *, personal=False):
    validate_board_mutations(query, variables or {})
    if personal:
        # The Ambition app lacks the Initiative scope.
        key = (Path(D) / "key").read_text().strip()
        return gql_request(query, variables, key, personal=True)
    access_token = token()
    try:
        return gql_request(query, variables, access_token)
    except LinearAPIError as exc:
        if exc.status != 401:
            raise
    return gql_request(query, variables, token(rejected=access_token))


def gql_request(query, variables, access_token, *, personal=False):
    req = urllib.request.Request(API, data=json.dumps({"query": query, "variables": variables or {}}).encode(),
                                 headers={"<REDACTED_AUTH_HEADER>": access_token if personal else "<REDACTED_AUTH_SCHEME> " + access_token, "Content-Type": "application/json"})
    status = 200
    try:
        d = json.loads(urllib.request.urlopen(req, timeout=60).read())
    except urllib.error.HTTPError as exc:
        status = exc.code
        try:
            d = json.loads(exc.read())
        except ValueError:
            raise LinearAPIError(status) from None
    if status >= 400 or d.get("errors") or "data" not in d:
        errors = d.get("errors") or []
        reasons = [graphql_error_reason(row, access_token) for row in errors[:5]]
        rate_limited = any(
            (row.get("extensions") or {}).get("type") == "rateLimited"
            or (row.get("extensions") or {}).get("code") == "USAGE_LIMIT_EXCEEDED"
            or "USAGE_LIMIT_EXCEEDED" in str(row.get("message", ""))
            for row in errors
        )
        raise LinearAPIError(status, rate_limited=rate_limited, reasons=reasons)
    return d["data"]


def graphql_error_reason(row, access_token):
    extensions = row.get("extensions") or {}
    reason = {}
    for key in ("code", "type"):
        value = extensions.get(key)
        if (isinstance(value, str) and re.fullmatch(r"[A-Za-z][A-Za-z0-9_]{0,39}", value)
                and not value.lower().startswith("lin_") and access_token not in value):
            reason[key] = value
    message = str(row.get("message") or "").replace(access_token, "[已隐藏]")
    # GraphQL validation messages can echo input values. Keep the reason and
    # discard quoted payloads, URLs, <REDACTED_AUTH_HEADER> values, and token-like strings.
    message = re.sub(r"""("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|`[^`]*`)""", "[已隐藏]", message)
    message = re.sub(r"https?://[^\s<>]+", "[URL]", message, flags=re.I)
    message = re.sub(r"(?i)\b(?:bearer|basic)\s+\S+|\b(?:lin_[\w.-]+|[\w./+=-]{24,})\b",
                     "[已隐藏]", message)
    message = re.sub(r"(?i)\b(?:<REDACTED_AUTH_HEADER>|access[_ -]?token|client[_ -]?secret|api[_ -]?key|"
                     r"password|credential|secret|token)\s*[:=]\s*\S+", "[已隐藏]", message)
    if message:
        reason["message"] = " ".join(message.split())[:300]
    return reason


def comment(ident, body):
    return gql("mutation($i:String!,$b:String!){commentCreate(input:{issueId:$i,body:$b}){success comment{id}}}", {"i": ident, "b": body})

def update(ident, **inp):
    return gql("mutation($i:String!,$in:IssueUpdateInput!){issueUpdate(id:$i,input:$in){success issue{identifier state{name} assignee{name}}}}", {"i": ident, "in": inp})

def pretty_title(t):
    """标题要让没看过上下文的人读懂在做什么：只去掉“Fable 统领：”“Ops：”这类执行者前缀，其余不删。"""
    t = re.sub(r"^\s*(Fable|Ops|OOS|Opus|Sol|Codex|Claude|Astra)[^：:]{0,6}[：:]\s*", "", t.strip(), flags=re.I)
    return t

